{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "web/**/*.{ts,tsx}": [
      "bash -c 'cd web && npx eslint ${@#web/}' --"
    ],
    "api/**/*.go": [
      "bash -c 'cd api && golangci-lint run ./...'"
    ]
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2"
  }
}
